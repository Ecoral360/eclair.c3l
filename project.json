{
  "authors": [
    "Mathis Laroche <ecomath360@gmail.com>"
  ],
  "build-dir": "build",
  "cpu": "generic",
  "dependencies": [
    "dessert"
  ],
  "dependency-search-paths": [
    "lib"
  ],
  "langrev": "1",
  "opt": "O0",
  "output": "build",
  "sources": [
    "src/**"
  ],
  "targets": {
    "eclair": {
      "type": "executable"
    },
    "example": {
      "c-include-dirs": [
        "csource/include"
      ],
      "c-sources": [
        "csource/**"
      ],
      "features": [
        "ECLAIR_EXAMPLE"
      ],
      "type": "executable"
    }
  },
  "test-sources": [
    "test/**"
  ],
  "version": "0.1.0",
  "warnings": [
    "no-unused"
  ]
}
